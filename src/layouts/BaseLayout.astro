---
import '../styles/global.css';
import ThemePicker from '../components/ThemePicker.astro';
import { site } from '../data/site';
import { locales, pageUrl, translations, type Locale, type Page } from '../i18n';
interface Props { locale: Locale; page: Page; description: string }
const { locale, page, description } = Astro.props;
const t = translations[locale];
const pages: Page[] = ['home', 'projects', 'taste'];
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{page === 'home' ? site.name : `${t[page]} | ${site.name}`}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="canonical" href={new URL(pageUrl(locale, page), Astro.site)} />
    {locales.map(lang => <link rel="alternate" hreflang={lang} href={new URL(pageUrl(lang, page), Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(pageUrl('en', page), Astro.site)} />
    <script is:inline>
      try {
        const theme = localStorage.getItem('theme');
        if (['light', 'dark', 'system'].includes(theme)) document.documentElement.dataset.theme = theme;
      } catch { /* Fall back to the device preference. */ }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>
    <header class="site-header container">
      <a class="brand" href={pageUrl(locale)}><img src="/images/bruun.svg" alt="" width="36" height="36" />{site.brand}</a>
      <nav class="tabs" aria-label={t.navigation}>
        {pages.map(item => <a href={pageUrl(locale, item)} aria-current={page === item ? 'page' : undefined}>{t[item]}</a>)}
      </nav>
      <div class="preferences">
        <nav class="languages" aria-label={t.language}>
          {locales.map(lang => <a href={pageUrl(lang, page)} lang={lang} hreflang={lang} aria-current={locale === lang ? 'true' : undefined}>{lang === 'en' ? 'English' : 'Suomi'}</a>)}
        </nav>
        <ThemePicker locale={locale} />
      </div>
    </header>
    <main id="main" class="container" tabindex="-1"><slot /></main>
    <footer class="site-footer container">
      <span>&copy; {new Date().getFullYear()} {site.name}</span>
      <a href={site.links[0].href}>GitHub ↗</a>
    </footer>
  </body>
</html>
