---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const animation = {
  old: {
    name: 'content-out',
    duration: '100ms',
    easing: 'ease-out',
    fillMode: 'both' as const,
  },
  new: {
    name: 'content-in',
    duration: '400ms',
    easing: 'ease-out',
    fillMode: 'both' as const,
  },
}

---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Juho Bruun</title>
    <ClientRouter />
  </head>
  <body transition:animate="none">
    <Header />

    <main
      transition:name="page-content"
      transition:animate={{
        forwards: animation,
        backwards: animation,
      }}
    >
        <slot />
    </main>

    <Footer />
  </body>
</html>