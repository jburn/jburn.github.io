---
import IconLink from "./IconLink.astro";
---

<footer>
    <p id="copyright">&copy; {new Date().getFullYear()} Juho Bruun. All rights reserved.</p>
    <IconLink
        href="https://github.com/jburn/jburn.github.io"
        icon="/assets/github.svg"
        label="Project GitHub"
        width="1.5rem"
    />
</footer>

<style>
    footer {
        width: 100%;
        margin-inline: auto;
        display: flex;
        flex-direction: row;
        justify-content: center;
        gap: 0.75rem;
        align-items: center;
        padding-block: 1rem;
    }

    #copyright {
        color: var(--color-muted);
        font-size: 0.75rem;
        font-weight: 400;
    }
</style>