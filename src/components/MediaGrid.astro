---
interface Props {
  items: Array<{ title: string; image: string }>;
  aspectRatio?: string;
  landscape?: boolean;
}
const { items, aspectRatio = '2 / 3', landscape = false } = Astro.props;
---

<ul class:list={['media-grid', { landscape }]} style={{ '--cover-ratio': aspectRatio }}>
  {items.map(item => (
    <li>
      <div class="media-cover">
        {item.image ? <img src={item.image} alt="" loading="lazy" /> : <span>No cover available</span>}
      </div>
      <h2>{item.title}</h2>
    </li>
  ))}
</ul>

<style>
  .media-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 10rem), 1fr));
    gap: 2rem 1.25rem;
    margin: 2rem 0;
    padding: 0;
    list-style: none;
  }
  .landscape {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
  }
  li {
    min-width: 0;
  }
  .media-cover {
    display: grid;
    place-items: center;
    aspect-ratio: var(--cover-ratio);
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    background: var(--color-surface);
    color: var(--color-muted);
    box-shadow: var(--thumbnail-shadow);
  }
  img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  h2 {
    margin: 0.75rem 0 0;
    font-size: 1rem;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }
  @media (max-width: 30rem) {
    .media-grid:not(.landscape) { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
