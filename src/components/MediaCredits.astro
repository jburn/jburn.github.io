---
interface Props { source: 'tmdb' | 'igdb' | 'openlibrary' }
const { source } = Astro.props;
---
<section class="credits" aria-label="Image credits">
  {source === 'tmdb' ? <>
    <a href="https://www.themoviedb.org/"><img src="/assets/tmdb-logo.svg" alt="TMDB" width="100" loading="lazy" /></a>
    <p>This product uses the TMDB API but is not endorsed or certified by TMDB.</p>
  </> : <p>Cover images from <a href={source === 'igdb' ? 'https://www.igdb.com/' : 'https://openlibrary.org/'}>{source === 'igdb' ? 'IGDB' : 'Open Library'}</a>.</p>}
</section>
<style>
  .credits {
    margin-top: 3rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
    color: var(--color-muted);
    font-size: 0.875rem;
    line-height: 1.6;
  }
  img {
    display: block;
    width: 6.25rem;
    height: auto;
  }
  a {
    color: inherit;
    text-underline-offset: 0.2em;
  }
  a:hover {
    color: var(--color-accent); 
  }
</style>
