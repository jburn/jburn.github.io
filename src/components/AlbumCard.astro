---
interface Props {
  title: string;
  artist: string;
  image: string;
  dialogId: string;
}
const { title, artist, image, dialogId } = Astro.props;
---

<div class="album-card">
  <button
    type="button"
    class="cover"
    data-album-dialog={dialogId}
    aria-haspopup="dialog"
    aria-controls={dialogId}
    aria-label={`View details for ${title} by ${artist}`}
    >
    {image
      ? <img src={image} alt="" loading="lazy" width="250" height="250" />
      : <span>No cover available</span>
      }
    </button>
  <h3 data-album-text>{title}</h3>
  <p data-album-text>{artist}</p>
  
  
</div>

<style>
  [data-album-text] {
    cursor: pointer;
  }

  .album-card {
    display: block;
    min-width: 0;
    color: inherit;
    text-decoration: none;
  }
  .cover {
    display: grid;
    place-items:
    center;
    aspect-ratio: 1;
    width: 100%;
    padding: 0;
    font: inherit;
    cursor: pointer;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    background: var(--color-surface);
    color: var(--color-muted);
    box-shadow: var(--thumbnail-shadow);
    transition:
      transform 250ms ease,
      box-shadow 250ms ease;
  }
  img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  h3 {
    margin:0.75rem 0 0.25rem;
    font-size: 1rem;
    overflow-wrap: anywhere;
  }
  p {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.875rem;
  }
  .cover:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 5px;
  }
  .album-card:hover h3 {
    color: var(--color-accent);
  }
  .album-card:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 5px;
    border-radius: 0.5rem;
  }
  @media (hover: hover) and (pointer: fine) {
    .cover:hover {
      transform: scale(1.1);
      box-shadow:
        var(--thumbnail-shadow),
        0 12px 20px rgb(0 0 0 / 15%);
    }
  }

@media (prefers-reduced-motion: reduce) {
    .cover {
      transition: none;
    }

    .cover:hover .cover {
      transform: none;
    }
  }
</style>

<script>
  // The cover remains the keyboard-accessible button for the same action.
  document.addEventListener('click', event => {
    if (!(event.target instanceof Element)) return;
    const text = event.target.closest('[data-album-text]');
    text?.closest('.album-card')
      ?.querySelector<HTMLButtonElement>('button[data-album-dialog]')?.click();
  });
</script>
