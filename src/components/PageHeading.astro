---
import BackLink from './BackLink.astro';

interface Props {
  title: string;
  backHref: string;
  backLabel: string;
}

const { title, backHref, backLabel } = Astro.props;
---

<div class="page-heading">
  <BackLink href={backHref} label={backLabel} />
  <h1>{title}</h1>
</div>

<style>
  .page-heading {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr);
    align-items: start;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  h1 {
    margin: 0;
    padding-block: 0.75rem;
    font-size: 2rem;
    line-height: 1.25;
    overflow-wrap: anywhere;
  }
</style>
