---
interface Props {
    href: string;
    icon: string;
    label: string;
    width?: string;
    aspectRatio?: string;
}

const {
    href,
    icon,
    label,
    width = '1.5rem',
    aspectRatio = '1',
} = Astro.props;
---


<a href={href} aria-label={label}>
    <span
        aria-hidden="true"
        style={{
            '--icon': `url("${icon}")`,
            '--width': width,
            '--aspect-ratio': aspectRatio,
        }}
    ></span>
</a>

<style>
    a {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: var(--color-text);

        /* Drop shadow on hover */
        filter: drop-shadow(0px 0px 0px transparent);
        transition: color 200ms ease, filter 200ms ease-in-out;
    }

    a:hover,
    a:focus-visible {
        color: var(--color-link-hover);
        filter: drop-shadow(0 2 3px rgb(18 81 158 / 50%));
    }

    :global(html[data-theme='dark']) a:hover,
    :global(html[data-theme='dark']) a:focus-visible {
        color: var(--color-text);
        filter: drop-shadow(0 0 3px currentColor);
    }

    a:focus-visible {
        outline: 2px solid var(--color-accent);
        outline-offset: 5px;
    }

    @media (prefers-reduced-motion: reduce) {
        a {
            transition: none;
        }

        a:hover {
            transform: none;
        }
    }

    span {
        display: block;
        width: var(--width);
        aspect-ratio: var(--aspect-ratio);
        background-color: currentColor;
        mask: var(--icon) center / contain no-repeat;
    } 
</style>