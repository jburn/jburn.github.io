---
import IconLink from "./IconLink.astro";
import NavLink from "./NavLink.astro";

const links = [
  { href: '/', label: 'Home' },
  { href: '/projects/', label: 'Projects' },
  { href: '/taste/', label: 'Taste' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---


<header>
  <IconLink
      href="/"
      icon="/assets/bruun.svg"
      label="Home"
      width="120px"
      aspectRatio="105.87 / 35.52"
    />
  <nav>
    <NavLink href="/" label="Home" />
    <NavLink href="/projects/" label="Projects" />
    <NavLink href="/taste/" label="Taste" />
  </nav>
</header>

<style>
    header {
        width: 100%;
        /* Flexbox props */
        display: flex;
        justify-content: space-between;
        align-items: center;

        margin-inline: auto;
        position: sticky;
        top: 0;
        z-index: 10;
        padding-block: 2rem;
    }
    nav {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
</style>