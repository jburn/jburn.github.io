---
import IconLink from "./IconLink.astro";
import NavLink from "./NavLink.astro";
---


<header>
  <IconLink
      href="/"
      icon="/assets/bruun.svg"
      label="Home"
      width="120px"
      aspectRatio="105.87 / 35.52"
    />

  <nav>
    <NavLink href="/" label="Home" />
    <NavLink href="/projects/" label="Projects" />
    <NavLink href="/taste/" label="Taste" />
  </nav>
</header>

<style>
    header {
        width: 100%;
        /* Flexbox props */
        display: flex;
        justify-content: space-between;
        align-items: center;

        margin-inline: auto;
        position: sticky;
        top: 0;
        z-index: 10;
        padding-block: 2rem;
    }

    header::before {
      content: '';
      position: absolute;
      inset: 0 0 -1rem;
      z-index: -1;
      pointer-events: none;

      background: linear-gradient(
        to bottom,
        var(--color-background) 0,
        var(--color-background) calc(100% - 2rem),
        transparent 100%
      );
    }

    nav {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    @media (max-width: 600px) {
      header {
        flex-wrap: wrap;
        gap: 1rem;
      }

      nav {
        flex-wrap: wrap;
      }

    }
</style>