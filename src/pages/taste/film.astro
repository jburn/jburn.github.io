---
import Layout from '../../layouts/Layout.astro';
import PageHeading from '../../components/PageHeading.astro';
import MediaGrid from '../../components/MediaGrid.astro';
import MediaCredits from '../../components/MediaCredits.astro';
import { previewFilmIds } from '../../data/film';
import { getTmdbMedia } from '../../lib/tmdb';
const films = await getTmdbMedia('movie', previewFilmIds);
---
<Layout title="Film">
  <PageHeading title="Film" backHref="/taste/" backLabel="Taste" />
  <MediaGrid items={films} />
  <MediaCredits source="tmdb" />
</Layout>
