---
import PageContent from '../components/PageContent.astro';
import { locales, type Locale, type Page } from '../i18n';

export function getStaticPaths() {
  const pages: Page[] = ['home', 'projects', 'taste'];
  return locales.flatMap(locale => pages.map(page => ({
    params: { path: [locale === 'en' ? '' : locale, page === 'home' ? '' : page].filter(Boolean).join('/') || undefined },
    props: { locale, page },
  })));
}
interface Props { locale: Locale; page: Page }
const { locale, page } = Astro.props;
---
<PageContent locale={locale} page={page} />
